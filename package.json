{
  "name": "yantu-assistant",
  "displayName": "研途助手",
  "description": "连接内部研发助手平台的 CodeBuddy IDE 对话扩展",
  "version": "0.4.3",
  "publisher": "skill-platform",
  "icon": "media/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/MagicianCat/opencode-gui.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yantu-assistant",
          "title": "研途助手",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "yantu-assistant": [
        {
          "type": "webview",
          "id": "yantu-assistant.chatView",
          "name": "研途助手"
        }
      ]
    },
    "configuration": {
      "title": "研途助手",
      "properties": {
        "yantuAssistant.apiBaseUrl": {
          "type": "string",
          "scope": "machine",
          "default": "http://127.0.0.1:8090/api/v1",
          "description": "研发助手平台 API 地址"
        },
        "yantuAssistant.webBaseUrl": {
          "type": "string",
          "scope": "machine",
          "default": "http://127.0.0.1:5173",
          "description": "研发助手平台网页地址"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "vite build --config vite.config.extension.ts",
    "build:webview": "vite build --config vite.config.ts",
    "watch": "concurrently \"npm run watch:extension\" \"npm run watch:webview\"",
    "watch:extension": "vite build --config vite.config.extension.ts --watch --mode development",
    "watch:webview": "vite build --config vite.config.ts --watch --mode development",
    "clean": "rm -rf dist out",
    "dev:webview": "vite",
    "test": "vitest run && playwright test",
    "test:integration": "tsc -p tsconfig.integration.json && node out/tests/integration/runTests.js",
    "test:integration:compile": "tsc -p tsconfig.integration.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev:codebuddy-bypass:install": "node local-dev-bypass/codebuddy-hook-bypass.mjs install",
    "dev:codebuddy-bypass:uninstall": "node local-dev-bypass/codebuddy-hook-bypass.mjs uninstall",
    "dev:codebuddy-bypass:status": "node local-dev-bypass/codebuddy-hook-bypass.mjs status",
    "test:codebuddy-bypass": "node --test local-dev-bypass/codebuddy-hook-bypass.test.mjs",
    "package": "vsce package",
    "publish": "vsce publish --skip-duplicate --no-dependencies && source .env && ovsx publish -p \"$OPEN_VSX_KEY\" --no-dependencies",
    "publish:pre": "vsce publish --pre-release --no-dependencies && source .env && ovsx publish --pre-release -p \"$OPEN_VSX_KEY\" --no-dependencies",
    "google-login": "gcloud auth application-default login"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/mocha": "^10.x",
    "@types/hast": "^3.0.4",
    "@types/node": "^20.x",
    "@types/vscode": "^1.74.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.x",
    "commander": "^12.x",
    "concurrently": "^8.x",
    "glob": "^11.x",
    "mocha": "^10.x",
    "tsx": "^4.x",
    "typescript": "^5.x",
    "vite": "^5.x",
    "vitest": "^1.x"
  },
  "dependencies": {
    "marked": "^17.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.19.0",
    "solid-js": "^1.9.10",
    "unified": "^11.0.5",
    "vite-plugin-solid": "^2.11.10",
    "zod": "^4.3.5"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
