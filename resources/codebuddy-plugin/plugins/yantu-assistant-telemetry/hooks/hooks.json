{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CODEBUDDY_PLUGIN_ROOT}/scripts/probe-hook.mjs UserPromptSubmit",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ${CODEBUDDY_PLUGIN_ROOT}/scripts/capture-generation.mjs UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CODEBUDDY_PLUGIN_ROOT}/scripts/probe-tool-name.mjs",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Skill|skill|use_skill",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CODEBUDDY_PLUGIN_ROOT}/scripts/capture-skill-usage.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ${CODEBUDDY_PLUGIN_ROOT}/scripts/capture-generation.mjs Skill",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CODEBUDDY_PLUGIN_ROOT}/scripts/capture-file-diff.mjs Post",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CODEBUDDY_PLUGIN_ROOT}/scripts/capture-file-diff.mjs Pre",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CODEBUDDY_PLUGIN_ROOT}/scripts/capture-generation.mjs ToolFailure",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CODEBUDDY_PLUGIN_ROOT}/scripts/probe-hook.mjs Stop",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ${CODEBUDDY_PLUGIN_ROOT}/scripts/capture-generation.mjs Stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
